# Copy this file to .env and fill in your real values.
# .env is in .gitignore so your secrets stay off GitHub.

# Supabase — get these from your project's Settings > API page
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# AI image generation — we'll add this when we wire up the image step
IMAGE_GEN_API_KEY=your-api-key-here

# Which AI provider to use (replicate | openai)
IMAGE_GEN_PROVIDER=replicate

# Supabase Storage bucket name where outfit images get saved
STORAGE_BUCKET=outfit-images

# Allowed origins for CORS (the store URLs that can call your API)
# Comma-separated, no trailing slash. * means any origin (fine for early dev).
ALLOWED_ORIGINS=*
